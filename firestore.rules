rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Sin autenticación: cualquiera puede leer y escribir. El scraper
    // (vía cuenta de servicio) y el panel admin.html escriben por igual.
    // Ver la nota de riesgo junto a este cambio en la conversación con Claude:
    // esto expone el directorio completo a edición por cualquiera con
    // acceso a internet, no solo a quien tenga el link del panel.
    match /autoridades/{docId} {
      allow read: if true;
      allow write: if true;
    }

    match /cambios_pendientes/{docId} {
      allow read, write: if true;
    }

    match /entidades/{docId} {
      allow read, write: if true;
    }

    match /proyectos_bid/{docId} {
      allow read, write: if true;
    }
  }
}

